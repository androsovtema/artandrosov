---
interface Props {
  activePage: 'projects' | 'about' | 'video';
  lang?: 'en' | 'ru';
}

const { activePage, lang = 'en' } = Astro.props;

const homeHref = lang === 'ru' ? '/ru/' : '/';
const aboutHref = lang === 'ru' ? '/ru/about' : '/about';
const cvHref = lang === 'ru' ? '/cv/ru/Art_Androsov_CV_RU.pdf' : '/cv/Art_Androsov_CV.pdf';
const videoHref = '/video';
const projectsLabel = lang === 'ru' ? 'Проекты' : 'Projects';
const aboutLabel = lang === 'ru' ? 'Обо мне' : 'About';
const cvLabel = lang === 'ru' ? 'Резюме' : 'CV';
const videoLabel = lang === 'ru' ? 'Видео' : 'Video';
---

<div class="sidebar">
    <a href={homeHref} class="logo-link">
        <div class="logo" data-lottie="/assets/icons/ArtLogo-animation.json"></div>
    </a>
    <nav class="nav-links">
        <a href={homeHref} class={activePage === 'projects' ? 'active' : ''}>{projectsLabel}</a>
        <a href={aboutHref} class={activePage === 'about' ? 'active' : ''}>{aboutLabel}</a>
        <a href={videoHref} class={activePage === 'video' ? 'active' : ''}>{videoLabel}</a>
        <a href={cvHref} download>{cvLabel}</a>
    </nav>
</div>

<script>
import lottie from 'lottie-web';

function initLottie() {
  document.querySelectorAll<HTMLElement>('[data-lottie]').forEach(el => {
    if (el.dataset.lottieInit) return;
    el.dataset.lottieInit = '1';
    const path = el.dataset.lottie;
    if (path) {
      lottie.loadAnimation({
        container: el,
        renderer: 'svg',
        loop: false,
        autoplay: true,
        path,
      });
    }
  });
}

document.addEventListener('astro:page-load', initLottie);
</script>
