---
interface Props {
  activePage: 'projects' | 'about';
}

const { activePage } = Astro.props;
---

<div class="sidebar">
    <a href="/"><img src="/assets/icons/ArtLogo.svg" alt="Art Logo" class="logo"></a>
    <nav class="nav-links">
        <a href="/" class={activePage === 'projects' ? 'active' : ''}>Projects</a>
        <a href="/about" class={activePage === 'about' ? 'active' : ''}>About</a>
    </nav>
</div>
