---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  activePage: 'projects' | 'about';
  lang?: 'en' | 'ru';
}

const { title, description, activePage, lang = 'en' } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <link slot="head" rel="stylesheet" href="/assets/css/project.css">
  <Sidebar activePage={activePage} lang={lang} />
  <div class="main-content">
    <slot />
  </div>
</BaseLayout>
