                    <Image src={eazyenergy2} alt="Eazy Energy — image 2" loading="lazy" decoding="async" />
                </div>
                <div class="gallery-item">
                    <Image src={eazyenergy3} alt="Eazy Energy — image 3" loading="lazy" decoding="async" />
                </div>
                <div class="gallery-item">
                    <Image src={eazyenergy4} alt="Eazy Energy — image 4" loading="lazy" decoding="async" />
                </div>
