                    <Image src={eazyenergy6} alt="Eazy Energy — image 6" loading="lazy" decoding="async" />
                </div>
                <div class="gallery-item">
                    <Image src={eazyenergy7} alt="Eazy Energy — image 7" loading="lazy" decoding="async" />
                </div>
