---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

import artemPhoto from '../assets/images/Artem.jpg';
---

<BaseLayout
  title="About - Artem Androsov"
  description="Freelance product designer working with clients across the UK, Switzerland, Latvia, Russia, and Indonesia. Runs We Designerz YouTube channel about AI in work and design."
  ogImage="/og/about.jpg"
>
  <link slot="head" rel="stylesheet" href="/assets/css/about.css">
  <Sidebar activePage="about" />

  <div class="main-content">
      <div class="hero">
          <div class="hero-text">
              <h1>Product designer turning ambiguity into shipped products. Based in Bali, working with teams across Europe.</h1>
              <div class="availability-badge">
                  <span class="availability-status">
                      <span class="availability-dot"></span>
                      Available
                  </span>
                  <span class="availability-divider" aria-hidden="true"></span>
                  <span><strong>EU hours</strong> · 8h overlap from GMT+8</span>
                  <span class="availability-divider" aria-hidden="true"></span>
                  <span>Contract / Full-time</span>
              </div>
              <p>I freelance with product and brand clients across the UK, Switzerland, Latvia, Russia, and Indonesia. I also run We Designerz — a YouTube channel about AI in work and life, with regular episodes on UX, product, and game design (370K+ views).</p>
              <p>Before going freelance, I spent four years inside top YouTube creators' teams: designed merch with 100K+ sales, built profitable websites, edited videos with 25M+ views, and grew a creator account on one social platform from zero to 500K subscribers.</p>
<p>
                  <a href="mailto:art.androsov@gmail.com">art.androsov@gmail.com</a> ·
                  <a href="https://www.linkedin.com/in/artandrosov/" target="_blank" rel="noopener">LinkedIn</a> ·
                  <a href="https://cal.com/artemandrosov/intro" target="_blank" rel="noopener">Book a call</a>
              </p>
          </div>
          <div class="hero-image">
              <Image src={artemPhoto} alt="Artem Portrait" />
          </div>
      </div>

      <div class="sections">
          <div class="section">
              <h2>Experience</h2>
              <div class="section-item">
                  <h3>Freelance</h3>
                  <p>Product Designer / UX/UI / Art Direction<br>2024 — present</p>
              </div>
              <div class="section-item">
                  <h3>YouTube Media</h3>
                  <p>Producer / Editor / SMM / Designer<br>2020 — 2024</p>
              </div>
          </div>

          <div class="section">
              <h2>Education</h2>
              <div class="section-item">
                  <h3>Google UX Design Professional Certificate, 2026 <span class="tooltip" data-tip="In progress">?</span></h3>
              </div>
              <div class="section-item">
                  <h3>RANEPA</h3>
                  <p>Bachelor of Economics<br>2019 - 2023</p>
              </div>
              <div class="section-item">
                  <h3>Moscow University for the Humanities</h3>
                  <p>Banking<br>2015 - 2018</p>
              </div>
          </div>

          <div class="section">
              <h2>Skills</h2>
              <div class="section-item">
                  <p>Product strategy<br>UX architecture<br>Figma (advanced)<br>Brand systems<br>Stakeholder management<br>Art direction</p>
              </div>
              <div class="section-item">
                  <p>Adobe CC (Pr, Ae, Ps, Ai)<br>DaVinci Resolve<br>Final Cut Pro<br>AI Tools &amp; Prompt Engineering</p>
              </div>
          </div>

          <div class="section">
              <h2>Reach &amp; Impact</h2>
              <div class="section-item">
                  <h3>Content &amp; reach</h3>
                  <p>25M+ views for top-tier YouTube creators<br>500,000+ subscribers on Telegram<br>370,000+ views
                      on We Designerz YouTube channel</p>
              </div>
              <div class="section-item">
                  <h3>Commerce</h3>
                  <p>100,000+ merch design sales<br>Profitable website architecture</p>
              </div>
          </div>
      </div>
  </div>
</BaseLayout>
